{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/server.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/snapshots",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/confirmations",
      "schedule": "*/2 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/trpc/:path*", "destination": "/api/server" },
    { "source": "/api/:path*",      "destination": "/api/server" },
    { "source": "/(.*)",            "destination": "/index.html" }
  ]
}
