{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": false,
    "baseUrl": "..",
    "resolveJsonModule": true
  },
  "include": ["index.ts", "../server/**/*", "../drizzle/**/*"]
}
